package com.example.inkpaperdiary.domain.model

data class Stats(
    val totalDiaries: Int = 0,
    val totalWords: Int = 0,
    val streakDays: Int = 0,
    val moodDistribution: Map<Mood, Int> = emptyMap(),
    val weatherDistribution: Map<Weather, Int> = emptyMap(),
    val topTags: List<Pair<String, Int>> = emptyList()
)
