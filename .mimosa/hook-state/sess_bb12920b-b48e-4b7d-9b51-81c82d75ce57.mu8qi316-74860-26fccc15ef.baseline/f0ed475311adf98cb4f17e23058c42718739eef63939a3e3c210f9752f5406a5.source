package com.example.inkpaperdiary

import com.example.inkpaperdiary.core.backup.TxtDiaryImporter
import com.example.inkpaperdiary.domain.model.Weather
import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test
import java.text.SimpleDateFormat
import java.util.*

class TxtDiaryImporterTest {

    private val dateFormatter = SimpleDateFormat("yyyy-MM-dd", Locale.getDefault())

    @Test
    fun testMultiEntryParsing() {
        val txt = """
            2023年5月1日 晴 游西湖
            今天和朋友一起游览西湖，断桥残雪，风景极美。
            #旅行 #西湖

            2023-05-02 14:30 雨 疲惫 在家看书
            下午下起淅淅沥沥的细雨，重读了《苏轼文集》，收获颇丰。
            #读书 #感悟
        """.trimIndent()

        val diaries = TxtDiaryImporter.parseTxt(txt)
        assertEquals(2, diaries.size)

        val first = diaries[0]
        assertEquals("游西湖", first.title)
        assertEquals("2023-05-01", dateFormatter.format(Date(first.entryDate)))
        assertEquals(Weather.SUNNY, first.weather)
        assertTrue(first.contentMarkdown.contains("断桥残雪"))
        assertEquals(2, first.tags.size)
        assertEquals("旅行", first.tags[0].name)
        assertEquals("西湖", first.tags[1].name)

        val second = diaries[1]
        assertEquals("在家看书", second.title)
        assertEquals("2023-05-02", dateFormatter.format(Date(second.entryDate)))
        assertEquals(Weather.RAINY, second.weather)
        assertTrue(second.contentMarkdown.contains("苏轼文集"))
        assertEquals(2, second.tags.size)
        assertEquals("读书", second.tags[0].name)
        assertEquals("感悟", second.tags[1].name)
    }

    @Test
    fun testSingleEntryWithFilenameDate() {
        val txt = """
            今天完成了重要的代码重构，心情十分舒畅。
            晚上散步看到天边的晚霞。
        """.trimIndent()

        val diaries = TxtDiaryImporter.parseTxt(txt, fileName = "2023-08-15_晚霞.txt")
        assertEquals(1, diaries.size)

        val diary = diaries[0]
        assertEquals("晚霞", diary.title)
        assertEquals("2023-08-15", dateFormatter.format(Date(diary.entryDate)))
        assertTrue(diary.contentMarkdown.contains("天边的晚霞"))
    }

    @Test
    fun testSingleEntryWithCompactFilenameDate() {
        val txt = """
            # 记录日常
            平凡而充实的一天。
        """.trimIndent()

        val diaries = TxtDiaryImporter.parseTxt(txt, fileName = "20231225.txt")
        assertEquals(1, diaries.size)

        val diary = diaries[0]
        assertEquals("记录日常", diary.title)
        assertEquals("2023-12-25", dateFormatter.format(Date(diary.entryDate)))
        assertTrue(diary.contentMarkdown.contains("平凡而充实的一天"))
    }

    @Test
    fun testEncodingFallbackGB18030() {
        val text = "2023年4月1日 晴\n愚人节的特殊随笔，怀念旧时光。"
        val gbkBytes = text.toByteArray(java.nio.charset.Charset.forName("GB18030"))

        val decoded = TxtDiaryImporter.readTextWithFallback(gbkBytes)
        val diaries = TxtDiaryImporter.parseTxt(decoded)

        assertEquals(1, diaries.size)
        assertEquals("2023-04-01", dateFormatter.format(Date(diaries[0].entryDate)))
        assertTrue(diaries[0].contentMarkdown.contains("怀念旧时光"))
    }

    @Test
    fun testFallbackToFileLastModified() {
        val txt = "没有日期的随手记事。"
        val sampleTime = 1672531199000L // 2022-12-31 23:59:59

        val diaries = TxtDiaryImporter.parseTxt(txt, fileName = "随记.txt", fileLastModified = sampleTime)
        assertEquals(1, diaries.size)

        val diary = diaries[0]
        assertEquals(sampleTime, diary.entryDate)
        assertEquals("随记", diary.title)
    }
}
