package com.example.inkpaperdiary.domain.model

import java.util.UUID

data class Diary(
    val id: String = UUID.randomUUID().toString(),
    val userId: String = "local_guest",
    val title: String = "",
    val contentMarkdown: String = "",
    // 天气仅作为可选的附加信息保留（历史数据兼容），不再主动采集
    val weather: Weather = Weather.SUNNY,
    val locationName: String? = null,
    val latitude: Double? = null,
    val longitude: Double? = null,
    val entryDate: Long = System.currentTimeMillis(),
    val createdAt: Long = System.currentTimeMillis(),
    val updatedAt: Long = System.currentTimeMillis(),
    val isPinned: Boolean = false,
    val isDeleted: Boolean = false,
    val deletedAt: Long? = null,
    val syncStatus: SyncStatus = SyncStatus.DIRTY,
    val tags: List<Tag> = emptyList(),
    val attachments: List<Attachment> = emptyList()
) {
    val wordCount: Int
        get() {
            val text = contentMarkdown.trim()
            if (text.isEmpty()) return 0
            // 中文字符按字计，英文/数字按单词计，更符合"字数"的直觉
            val cjkChars = text.count { it.isCjkChar() }
            val latinWords = Regex("[A-Za-z0-9]+(?:['’’-][A-Za-z0-9]+)*")
                .findAll(text)
                .count()
            return cjkChars + latinWords
        }
        
    val previewText: String
        get() {
            // 剥离 Markdown 符号提取纯文本摘要
            val plain = contentMarkdown
                .replace(Regex("(?m)^#+\\s+"), "")
                .replace(Regex("\\[(.*?)\\]\\(.*?\\)"), "$1")
                .replace(Regex("[*_`~>]"), "")
                .trim()
            return if (plain.length > 120) plain.take(120) + "..." else plain
        }
}

/** 判断是否为中日韩统一表意文字（含扩展区、假名等，均按单字计数）。 */
private fun Char.isCjkChar(): Boolean {
    val code = this.code
    return code in 0x3400..0x4DBF ||   // CJK 扩展 A
        code in 0x4E00..0x9FFF ||   // CJK 统一表意文字
        code in 0xF900..0xFAFF ||   // CJK 兼容表意文字
        code in 0x3040..0x30FF ||   // 平假名/片假名
        code in 0xAC00..0xD7AF     // 谚文音节
}
