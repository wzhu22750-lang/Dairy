package com.example.inkpaperdiary.core.backup

import android.content.Context
import android.net.Uri
import android.provider.OpenableColumns
import com.example.inkpaperdiary.domain.model.Diary
import com.example.inkpaperdiary.domain.model.Tag
import com.example.inkpaperdiary.domain.model.Weather
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import java.io.InputStream
import java.nio.ByteBuffer
import java.nio.charset.CodingErrorAction
import java.util.*
import java.util.regex.Pattern

/**
 * TXT 纯文本日记智能解析与导入器
 *
 * 核心功能：
 * 1. 编码自适应兼容：支持 UTF-8（带/不带 BOM）与 GB18030 / GBK / GB2312 自动回退，解决 Windows 记事本旧日记乱码问题；
 * 2. 智能多篇日记拆分：自动识别文本中以日期开头的多个篇章（如 "2023年5月1日 晴" 或 "【2023-05-01】"）；
 * 3. 历史日期推断矩阵：内容头部日期 -> 文件名日期 -> 文件修改时间戳 -> 当前系统时间；
 * 4. 元数据提取：自动提取天气关键词（晴/雨/阴/雪/风/多云）、心情关键词（喜/怒/哀/乐/安/累）、时间戳（如 14:30）及标签（#旅行 #思考）。
 */
object TxtDiaryImporter {

    // 匹配如 2023年5月1日、2023-05-01、2023/5/1、2023.05.01、20230501
    private val DATE_PATTERN = Pattern.compile(
        """(?:^|[【\[(（])?\s*(\d{4})\s*(?:[年/.-]|(?=\d{4}))\s*(\d{1,2})\s*(?:[月/.-]|(?=\d{2}))\s*(\d{1,2})\s*日?(?:[】\])）])?"""
    )

    // 匹配时间：14:30、14:30:00、下午 2:30、09:15
    private val TIME_PATTERN = Pattern.compile(
        """([上下]午|PM|AM)?\s*(\d{1,2})[:：](\d{1,2})(?:[:：](\d{1,2}))?""",
        Pattern.CASE_INSENSITIVE
    )

    // 匹配星期（避免被误作为标题）：星期一、周日、礼拜三等
    private val WEEKDAY_PATTERN = Pattern.compile("""(星期[一二三四五六日天]|周[一二三四五六日天]|礼拜[一二三四五六日天])""")

    // 匹配标签：#生活 #随笔
    private val HASHTAG_PATTERN = Pattern.compile("""#([\w\u4e00-\u9fa5]{1,20})(?:\s|$)""")

    /**
     * 读取字节流并自适应兼容 UTF-8 和 GB18030/GBK 编码
     */
    fun readTextWithFallback(bytes: ByteArray): String {
        val decoded = try {
            val decoder = Charsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
            decoder.decode(ByteBuffer.wrap(bytes)).toString()
        } catch (e: Exception) {
            try {
                String(bytes, java.nio.charset.Charset.forName("GB18030"))
            } catch (e2: Exception) {
                String(bytes, Charsets.UTF_8)
            }
        }
        return decoded.removePrefix("\uFEFF").replace("\r\n", "\n").replace('\r', '\n')
    }

    /**
     * 从输入流直接解析并生成日记列表
     */
    fun parseFromStream(
        inputStream: InputStream,
        fileName: String? = null,
        fileLastModified: Long? = null
    ): List<Diary> {
        val bytes = inputStream.readBytes()
        val text = readTextWithFallback(bytes)
        return parseTxt(text, fileName, fileLastModified)
    }

    /**
     * 解析文本内容为一篇或多篇日记
     */
    fun parseTxt(
        content: String,
        fileName: String? = null,
        fileLastModified: Long? = null
    ): List<Diary> {
        val normalized = content.trim()
        if (normalized.isEmpty()) return emptyList()

        val lines = normalized.lines()
        val entryRanges = findEntryHeaderLines(lines)

        // 若识别到了 1 个及以上明确的日期行，且各篇章有正文，则按多篇/单篇结构拆分
        if (entryRanges.isNotEmpty()) {
            val diaries = mutableListOf<Diary>()
            for (i in entryRanges.indices) {
                val headerLineIndex = entryRanges[i]
                val nextHeaderLineIndex = if (i + 1 < entryRanges.size) entryRanges[i + 1] else lines.size
                val headerLine = lines[headerLineIndex]
                val bodyLines = lines.subList(headerLineIndex + 1, nextHeaderLineIndex)

                val parsed = parseSingleEntry(
                    headerLine = headerLine,
                    bodyLines = bodyLines,
                    fileName = fileName,
                    fileLastModified = fileLastModified
                )
                if (parsed != null) {
                    diaries.add(parsed)
                }
            }
            if (diaries.isNotEmpty()) {
                return diaries
            }
        }

        // 无法在文本行首找到明确日期行，则整体作为一篇单篇日记导入
        val fallbackEntry = parseSingleFileAsOneEntry(lines, fileName, fileLastModified)
        return if (fallbackEntry != null) listOf(fallbackEntry) else emptyList()
    }

    /**
     * 寻找符合日期标题行规则的行号
     */
    private fun findEntryHeaderLines(lines: List<String>): List<Int> {
        val headerIndices = mutableListOf<Int>()
        for (i in lines.indices) {
            val line = lines[i].trim()
            if (line.isEmpty()) continue
            // 日期标题行通常较短（例如：2023年5月1日 晴 游西湖，很少超过 60 个字符）
            if (line.length <= 70 && isDateHeaderLine(line)) {
                headerIndices.add(i)
            }
        }
        return headerIndices
    }

    private fun isDateHeaderLine(line: String): Boolean {
        val clean = line.removePrefix("#").removePrefix("---").trim()
        val matcher = DATE_PATTERN.matcher(clean)
        if (matcher.find()) {
            // 确保日期位于行首附近（避免匹配正文中途出现的日期如 "我出生于1995年..."）
            return matcher.start() <= 6
        }
        return false
    }

    /**
     * 解析包含日期行与正文的单个篇章
     */
    private fun parseSingleEntry(
        headerLine: String,
        bodyLines: List<String>,
        fileName: String?,
        fileLastModified: Long?
    ): Diary? {
        val entryDate = parseDateTime(headerLine)
            ?: extractDateFromFileName(fileName ?: "")
            ?: (fileLastModified?.takeIf { it > 0 })
            ?: System.currentTimeMillis()

        val weather = detectWeather(headerLine) ?: detectWeatherInLines(bodyLines.take(3)) ?: Weather.SUNNY

        var title = extractTitleFromHeader(headerLine)
        val bodyBuilder = mutableListOf<String>()
        var foundBodyTitle = false

        for (line in bodyLines) {
            val trimmed = line.trim()
            if (!foundBodyTitle && title.isBlank() && trimmed.isNotEmpty()) {
                // 尝试从第一行正文提取标题（如 # 标题、标题：xxx）
                if (trimmed.startsWith("# ")) {
                    title = trimmed.removePrefix("# ").trim()
                    foundBodyTitle = true
                    continue
                } else if (trimmed.startsWith("标题：") || trimmed.startsWith("标题:")) {
                    title = trimmed.substring(3).trim()
                    foundBodyTitle = true
                    continue
                } else if (trimmed.startsWith("Title:", ignoreCase = true)) {
                    title = trimmed.substring(6).trim()
                    foundBodyTitle = true
                    continue
                }
            }
            bodyBuilder.add(line)
        }

        val contentMarkdown = bodyBuilder.joinToString("\n").trim()
        // 若内容和标题均为空，忽略此条
        if (title.isBlank() && contentMarkdown.isBlank()) {
            return null
        }

        val tags = extractTags(contentMarkdown)

        return Diary(
            title = title,
            contentMarkdown = contentMarkdown,
            entryDate = entryDate,
            createdAt = entryDate,
            updatedAt = System.currentTimeMillis(),
            weather = weather,
            tags = tags
        )
    }

    /**
     * 当文本无明显日期标题时，将整个文本作为单篇日记解析
     */
    private fun parseSingleFileAsOneEntry(
        lines: List<String>,
        fileName: String?,
        fileLastModified: Long?
    ): Diary? {
        val nonBlankLines = lines.filter { it.isNotBlank() }
        if (nonBlankLines.isEmpty()) return null

        // 尝试从文件名、首行或文件时间戳推断日期
        val dateFromFirstLine = nonBlankLines.firstOrNull()?.let { parseDateTime(it) }
        val dateFromFileName = fileName?.let { extractDateFromFileName(it) }
        val entryDate = dateFromFirstLine
            ?: dateFromFileName
            ?: (fileLastModified?.takeIf { it > 0 })
            ?: System.currentTimeMillis()

        var title = ""
        val bodyBuilder = mutableListOf<String>()
        var skippedFirstLine = false

        // 检查首行是否就是文件名日期或被识别出的日期行
        val firstLine = nonBlankLines.first()
        if (dateFromFirstLine != null && firstLine.trim().length <= 60) {
            title = extractTitleFromHeader(firstLine)
            skippedFirstLine = true
        }

        // 如果首行没有标题，尝试使用文件名中的非日期部分
        if (title.isBlank() && !fileName.isNullOrBlank()) {
            val cleanName = fileName.substringBeforeLast('.')
                .replace(Regex("""\d{4}[-_./年]\d{1,2}[-_./月]\d{1,2}日?"""), "")
                .replace(Regex("""\d{8}"""), "")
                .replace(Regex("""^[-_ ]+|[-_ ]+$"""), "")
                .trim()
            if (cleanName.isNotBlank()) {
                title = cleanName
            }
        }

        var foundFirstContent = false
        for (line in lines) {
            val trimmed = line.trim()
            if (skippedFirstLine && !foundFirstContent && trimmed == firstLine.trim()) {
                foundFirstContent = true
                continue
            }
            if (title.isBlank() && trimmed.isNotEmpty()) {
                if (trimmed.startsWith("# ")) {
                    title = trimmed.removePrefix("# ").trim()
                    continue
                } else if (trimmed.startsWith("标题：") || trimmed.startsWith("标题:")) {
                    title = trimmed.substring(3).trim()
                    continue
                }
            }
            bodyBuilder.add(line)
        }

        val contentMarkdown = bodyBuilder.joinToString("\n").trim()
        val weather = detectWeatherInLines(lines.take(5)) ?: Weather.SUNNY
        val tags = extractTags(contentMarkdown)

        return Diary(
            title = title,
            contentMarkdown = contentMarkdown,
            entryDate = entryDate,
            createdAt = entryDate,
            updatedAt = System.currentTimeMillis(),
            weather = weather,
            tags = tags
        )
    }

    /**
     * 从字符串中解析年月日及具体时间
     */
    fun parseDateTime(text: String): Long? {
        val dateMatcher = DATE_PATTERN.matcher(text)
        if (!dateMatcher.find()) return null

        val year = dateMatcher.group(1)?.toIntOrNull() ?: return null
        val month = dateMatcher.group(2)?.toIntOrNull() ?: return null
        val day = dateMatcher.group(3)?.toIntOrNull() ?: return null

        val cal = Calendar.getInstance()
        cal.set(Calendar.YEAR, year)
        cal.set(Calendar.MONTH, month - 1)
        cal.set(Calendar.DAY_OF_MONTH, day)
        cal.set(Calendar.SECOND, 0)
        cal.set(Calendar.MILLISECOND, 0)

        val timeMatcher = TIME_PATTERN.matcher(text)
        if (timeMatcher.find()) {
            val period = timeMatcher.group(1) // 上午/下午/PM/AM
            var hour = timeMatcher.group(2)?.toIntOrNull() ?: 12
            val minute = timeMatcher.group(3)?.toIntOrNull() ?: 0
            val second = timeMatcher.group(4)?.toIntOrNull() ?: 0

            if (period != null) {
                val isPm = period.contains("下午") || period.equals("PM", ignoreCase = true)
                val isAm = period.contains("上午") || period.equals("AM", ignoreCase = true)
                if (isPm && hour in 1..11) hour += 12
                if (isAm && hour == 12) hour = 0
            }

            cal.set(Calendar.HOUR_OF_DAY, hour.coerceIn(0, 23))
            cal.set(Calendar.MINUTE, minute.coerceIn(0, 59))
            cal.set(Calendar.SECOND, second.coerceIn(0, 59))
        } else {
            // 未指定时间默认设为当日常规记日记时间（如 20:00），避免都堆在 00:00:00
            cal.set(Calendar.HOUR_OF_DAY, 20)
            cal.set(Calendar.MINUTE, 0)
        }

        return cal.timeInMillis
    }

    /**
     * 从文件名中提取日期
     * 例如："2023-10-01.txt", "20231001_西湖.txt", "2023年5月12日日记.txt"
     */
    fun extractDateFromFileName(fileName: String): Long? {
        val clean = fileName.substringBeforeLast('.')
        // 尝试标准匹配
        val matcher = DATE_PATTERN.matcher(clean)
        if (matcher.find()) {
            val year = matcher.group(1)?.toIntOrNull() ?: return null
            val month = matcher.group(2)?.toIntOrNull() ?: return null
            val day = matcher.group(3)?.toIntOrNull() ?: return null
            val cal = Calendar.getInstance()
            cal.set(year, month - 1, day, 20, 0, 0)
            cal.set(Calendar.MILLISECOND, 0)
            return cal.timeInMillis
        }

        // 尝试紧凑 8 位数字如 "20230501"
        val compactPattern = Pattern.compile("""(?:\b|[^0-9])(\d{4})(0[1-9]|1[0-2])(0[1-9]|[12]\d|3[01])(?:\b|[^0-9])""")
        val compactMatcher = compactPattern.matcher(clean)
        if (compactMatcher.find()) {
            val year = compactMatcher.group(1)?.toIntOrNull() ?: return null
            val month = compactMatcher.group(2)?.toIntOrNull() ?: return null
            val day = compactMatcher.group(3)?.toIntOrNull() ?: return null
            val cal = Calendar.getInstance()
            cal.set(year, month - 1, day, 20, 0, 0)
            cal.set(Calendar.MILLISECOND, 0)
            return cal.timeInMillis
        }

        return null
    }

    /**
     * 从日期标题行中剥除日期、时间、天气、心情、星期后，将剩余有效文本作为标题
     */
    fun extractTitleFromHeader(headerLine: String): String {
        var clean = headerLine
            .replace(Regex("""^#+\s*"""), "")
            .replace(Regex("""^---+\s*"""), "")
            .trim()

        // 移除括号
        clean = clean.replace(Regex("""^[【\[(（]"""), "").replace(Regex("""[】\])）]$"""), "")

        // 移除日期
        clean = clean.replace(DATE_PATTERN.toRegex(), " ")

        // 移除时间
        clean = clean.replace(TIME_PATTERN.toRegex(), " ")

        // 移除星期
        clean = clean.replace(WEEKDAY_PATTERN.toRegex(), " ")

        // 移除天气关键词
        val weatherKeywords = listOf("晴天", "晴", "多云", "阴天", "阴", "暴雨", "大雨", "小雨", "雨", "大雪", "小雪", "雪", "大风", "风")
        for (kw in weatherKeywords) {
            clean = clean.replace(kw, " ")
        }

        // 移除残余标点符号
        clean = clean.replace(Regex("""[|:：,，\-~_]+"""), " ").trim()
        return clean
    }

    fun detectWeather(text: String): Weather? {
        return when {
            text.contains("晴") -> Weather.SUNNY
            text.contains("多云") -> Weather.CLOUDY
            text.contains("阴") -> Weather.OVERCAST
            text.contains("雨") -> Weather.RAINY
            text.contains("雪") -> Weather.SNOWY
            text.contains("风") -> Weather.WINDY
            else -> null
        }
    }

    private fun detectWeatherInLines(lines: List<String>): Weather? {
        for (line in lines) {
            val w = detectWeather(line)
            if (w != null) return w
        }
        return null
    }

    fun extractTags(content: String): List<Tag> {
        val matcher = HASHTAG_PATTERN.matcher(content)
        val tags = mutableListOf<Tag>()
        val seen = mutableSetOf<String>()
        while (matcher.find()) {
            val tagName = matcher.group(1)?.trim()
            if (!tagName.isNullOrEmpty() && seen.add(tagName)) {
                tags.add(Tag(id = UUID.randomUUID().toString(), name = tagName))
            }
        }
        return tags
    }

    /**
     * 批量导入 Uri 列表对应的纯文本日记
     * @return Pair(成功保存的日记篇数, 读取失败的文件数)
     */
    suspend fun importTxtUris(
        context: Context,
        uris: List<Uri>,
        onSaveDiary: suspend (Diary) -> Unit
    ): Pair<Int, Int> = withContext(Dispatchers.IO) {
        var totalCount = 0
        var failedFiles = 0
        for (uri in uris) {
            try {
                var fileName: String? = null
                context.contentResolver.query(uri, null, null, null, null)?.use { cursor ->
                    val nameIndex = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
                    if (nameIndex != -1 && cursor.moveToFirst()) {
                        fileName = cursor.getString(nameIndex)
                    }
                }
                val inputStream = context.contentResolver.openInputStream(uri)
                if (inputStream != null) {
                    val diaries = inputStream.use { stream ->
                        parseFromStream(stream, fileName, null)
                    }
                    for (d in diaries) {
                        onSaveDiary(d)
                        totalCount++
                    }
                } else {
                    failedFiles++
                }
            } catch (e: Exception) {
                failedFiles++
            }
        }
        Pair(totalCount, failedFiles)
    }
}
