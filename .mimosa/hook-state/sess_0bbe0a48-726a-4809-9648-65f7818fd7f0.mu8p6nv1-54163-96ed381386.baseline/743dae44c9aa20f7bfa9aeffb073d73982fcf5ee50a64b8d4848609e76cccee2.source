package com.example.inkpaperdiary.tier1_features

import com.example.inkpaperdiary.core.backup.BackupManager
import com.example.inkpaperdiary.core.database.entity.AttachmentEntity
import com.example.inkpaperdiary.core.database.entity.DiaryEntity
import com.example.inkpaperdiary.core.database.entity.DiaryTagCrossRef
import com.example.inkpaperdiary.core.database.entity.TagEntity
import com.example.inkpaperdiary.core.network.SupabaseClient
import com.example.inkpaperdiary.core.security.AppLockManager
import com.example.inkpaperdiary.domain.model.Diary
import com.example.inkpaperdiary.domain.model.SyncStatus
import com.example.inkpaperdiary.domain.model.Weather
import kotlinx.coroutines.runBlocking
import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertTrue
import org.junit.Test
import java.util.UUID

/**
 * Tier 1: Feature Coverage for R4: Business Logic Preservation & Zero Regression
 * Covers Features F15, F16, F17 (>= 5 tests per feature)
 */
class R4BusinessLogicFeatureTest {

    // ---------------------------------------------------------------------------------------------
    // F15: Room Entities & Database Schemas (>= 5 tests)
    // ---------------------------------------------------------------------------------------------

    @Test
    fun testF15_DiaryEntityDefaultValues() {
        val id = UUID.randomUUID().toString()
        val entity = DiaryEntity(id = id)

        assertEquals(id, entity.id)
        assertEquals("local_guest", entity.userId)
        assertEquals("", entity.title)
        assertEquals("", entity.contentMarkdown)
        assertEquals("CALM", entity.mood)
        assertEquals("SUNNY", entity.weather)
        assertEquals(false, entity.isPinned)
        assertEquals(false, entity.isDeleted)
        assertEquals(1, entity.syncStatus) // 1 = DIRTY by default
    }

    @Test
    fun testF15_DiaryEntityIndicesIntegrity() {
        val testEntity = DiaryEntity(
            id = "test_id",
            userId = "user_1",
            title = "标题",
            contentMarkdown = "正文",
            mood = "HAPPY",
            weather = "RAINY",
            locationName = "成都",
            latitude = 30.65,
            longitude = 104.06,
            entryDate = 1700000000000L,
            createdAt = 1700000000000L,
            updatedAt = 1700000000000L,
            isPinned = true,
            isDeleted = false,
            deletedAt = null,
            syncStatus = 0
        )

        assertEquals("test_id", testEntity.id)
        assertEquals("user_1", testEntity.userId)
        assertEquals(30.65, testEntity.latitude!!, 0.001)
        assertEquals(104.06, testEntity.longitude!!, 0.001)
        assertEquals(1700000000000L, testEntity.entryDate)
        assertEquals(true, testEntity.isPinned)
        assertEquals(false, testEntity.isDeleted)
        assertEquals(0, testEntity.syncStatus)

        // Verify source declaration contains required indexes
        val entitySource = java.io.File("src/main/java/com/example/inkpaperdiary/core/database/entity/DiaryEntity.kt")
        if (entitySource.exists()) {
            val content = entitySource.readText()
            assertTrue(content.contains("Index(value = [\"entryDate\"])"))
            assertTrue(content.contains("Index(value = [\"isDeleted\"])"))
            assertTrue(content.contains("Index(value = [\"isPinned\"])"))
            assertTrue(content.contains("Index(value = [\"syncStatus\"])"))
        }
    }

    @Test
    fun testF15_AttachmentEntitySchema() {
        val id = UUID.randomUUID().toString()
        val diaryId = UUID.randomUUID().toString()
        val attachment = AttachmentEntity(
            id = id,
            diaryId = diaryId,
            localPath = "/data/user/0/com.example.inkpaperdiary/files/img.jpg",
            fileName = "img.jpg",
            fileSize = 1024L,
            mimeType = "image/webp",
            sortOrder = 0,
            syncStatus = 1
        )

        assertEquals(id, attachment.id)
        assertEquals(diaryId, attachment.diaryId)
        assertEquals("img.jpg", attachment.fileName)
        assertEquals("image/webp", attachment.mimeType)
        assertEquals(0, attachment.sortOrder)
    }

    @Test
    fun testF15_TagEntityAndCrossRefSchema() {
        val tagId = "tag_tech"
        val diaryId = UUID.randomUUID().toString()
        val tag = TagEntity(id = tagId, name = "技术", colorHex = "#007AFF")
        val crossRef = DiaryTagCrossRef(diaryId = diaryId, tagId = tagId)

        assertEquals(tagId, tag.id)
        assertEquals("技术", tag.name)
        assertEquals("#007AFF", tag.colorHex)
        assertEquals(diaryId, crossRef.diaryId)
        assertEquals(tagId, crossRef.tagId)
    }

    @Test
    fun testF15_DiarySyncStatusEnumMapping() {
        assertEquals(0, SyncStatus.SYNCED.code)
        assertEquals(1, SyncStatus.DIRTY.code)
        assertEquals(2, SyncStatus.DELETED.code)

        assertEquals(SyncStatus.SYNCED, SyncStatus.fromCode(0))
        assertEquals(SyncStatus.DIRTY, SyncStatus.fromCode(1))
        assertEquals(SyncStatus.DELETED, SyncStatus.fromCode(2))
        assertEquals(SyncStatus.DIRTY, SyncStatus.fromCode(999)) // Fallback to DIRTY
    }

    // ---------------------------------------------------------------------------------------------
    // F16: Security & AppLockManager (>= 5 tests)
    // ---------------------------------------------------------------------------------------------

    @Test
    fun testF16_AppLockStateFlowDefaultAndTransitions() {
        AppLockManager.lock()
        assertTrue(AppLockManager.isLocked.value)

        AppLockManager.unlock()
        assertFalse(AppLockManager.isLocked.value)

        AppLockManager.lock()
        assertTrue(AppLockManager.isLocked.value)
    }

    @Test
    fun testF16_IsPickerActiveFlagContract() {
        AppLockManager.isPickerActive = false
        assertFalse(AppLockManager.isPickerActive)

        // Starting photo/document picker sets isPickerActive = true
        AppLockManager.isPickerActive = true
        assertTrue(AppLockManager.isPickerActive)

        // Reset when returning
        AppLockManager.isPickerActive = false
        assertFalse(AppLockManager.isPickerActive)
    }

    @Test
    fun testF16_PickerActivePreventsAppLockOnStop() {
        AppLockManager.unlock()
        assertFalse(AppLockManager.isLocked.value)

        // Simulate activity onStop with isPickerActive = true
        AppLockManager.isPickerActive = true
        if (!AppLockManager.isPickerActive) {
            AppLockManager.lock()
        }

        // Must remain UNLOCKED because external picker was active
        assertFalse(AppLockManager.isLocked.value)

        // When picker returns, isPickerActive resets to false
        AppLockManager.isPickerActive = false

        // Subsequent onStop without picker locks the app
        if (!AppLockManager.isPickerActive) {
            AppLockManager.lock()
        }
        assertTrue(AppLockManager.isLocked.value)
    }

    @Test
    fun testF16_RepeatedLockCallsAreIdempotent() {
        AppLockManager.lock()
        assertTrue(AppLockManager.isLocked.value)
        AppLockManager.lock()
        assertTrue(AppLockManager.isLocked.value)
        AppLockManager.lock()
        assertTrue(AppLockManager.isLocked.value)
    }

    @Test
    fun testF16_RepeatedUnlockCallsAreIdempotent() {
        AppLockManager.unlock()
        assertFalse(AppLockManager.isLocked.value)
        AppLockManager.unlock()
        assertFalse(AppLockManager.isLocked.value)
    }

    // ---------------------------------------------------------------------------------------------
    // F17: Cloud Sync & Backup Data Integrity (>= 5 tests)
    // ---------------------------------------------------------------------------------------------

    @Test
    fun testF17_SupabaseClientConfigurationDetection() {
        val unconfigured = SupabaseClient("", "")
        assertFalse(unconfigured.isConfigured)

        val partiallyConfigured = SupabaseClient("https://test.supabase.co", "")
        assertFalse(partiallyConfigured.isConfigured)

        val configured = SupabaseClient("https://test.supabase.co", "anon_key_123")
        assertTrue(configured.isConfigured)
    }

    @Test
    fun testF17_SupabaseClientUrlNormalization() {
        val client = SupabaseClient("https://test.supabase.co/", "key")
        assertTrue(client.isConfigured)
    }

    @Test
    fun testF17_BackupManagerJsonExportAndImportIntegrity() = runBlocking {
        val sampleJson = """
            [
              {
                "id": "22222222-3333-4444-5555-666666666666",
                "userId": "user_001",
                "title": "备份测试",
                "contentMarkdown": "完整数据导出测试",
                "mood": "CALM",
                "weather": "SUNNY",
                "locationName": "成都市",
                "entryDate": 1700000000000,
                "createdAt": 1700000000000,
                "updatedAt": 1700000000000,
                "isPinned": true,
                "tags": [
                  {
                    "id": "tag_01",
                    "name": "读书",
                    "colorHex": "#9E3323"
                  }
                ]
              }
            ]
        """.trimIndent()

        val importResult = BackupManager.importFromJson(sampleJson)
        assertTrue(importResult.isSuccess)
        val list = importResult.getOrNull()!!
        assertEquals(1, list.size)
        assertEquals("备份测试", list[0].title)
        assertEquals(true, list[0].isPinned)
        assertEquals("成都市", list[0].locationName)
        assertEquals(1, list[0].tags.size)
        assertEquals("读书", list[0].tags[0].name)
    }

    @Test
    fun testF17_BackupManagerMalformedJsonHandling() = runBlocking {
        val malformedJson = "{ invalid json content }"
        val result = BackupManager.importFromJson(malformedJson)
        assertTrue(result.isFailure)
    }

    @Test
    fun testF17_DiaryDomainModelWordCountCalculation() {
        val diary = Diary(
            title = "测试",
            contentMarkdown = "这是一篇关于 Apple HIG 的中文日记，包含 100% 还原度和 Swift 风格组件。"
        )
        assertTrue(diary.wordCount > 0)
        assertTrue(diary.previewText.contains("Apple HIG"))
    }
}
