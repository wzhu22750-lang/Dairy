package com.example.inkpaperdiary.data.repository

import android.content.Context
import android.graphics.Bitmap
import android.graphics.BitmapFactory
import android.net.Uri
import com.example.inkpaperdiary.domain.model.Attachment
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import java.io.File
import java.io.FileOutputStream
import java.util.UUID

/** 媒体存储契约，供 ViewModel 与测试替身使用 */
interface MediaStore {
    suspend fun saveImageFromUri(uri: Uri, diaryId: String): Attachment?
}

class MediaRepository(private val context: Context) : MediaStore {

    private val mediaDir = File(context.filesDir, "diary_media").apply {
        if (!exists()) mkdirs()
    }

    override suspend fun saveImageFromUri(uri: Uri, diaryId: String): Attachment? = withContext(Dispatchers.IO) {
        try {
            val inputStream = context.contentResolver.openInputStream(uri) ?: return@withContext null

            // 先只读边界解码拿到尺寸，避免全尺寸解码造成内存峰值
            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
            BitmapFactory.decodeStream(inputStream, null, bounds)
            inputStream.close()

            if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return@withContext null

            // 根据目标尺寸计算采样率，控制解码内存占用
            val sampleSize = calculateInSampleSize(bounds.outWidth, bounds.outHeight, maxDimension = 2048)
            val decodeOptions = BitmapFactory.Options().apply {
                inSampleSize = sampleSize
                inPreferredConfig = Bitmap.Config.ARGB_8888
            }
            val originalBitmap = context.contentResolver.openInputStream(uri)?.use { stream ->
                BitmapFactory.decodeStream(stream, null, decodeOptions)
            } ?: return@withContext null

            // 缩放到最大长边 2048px，保留高清画质同时控制体积
            val scaledBitmap = scaleBitmapIfNeeded(originalBitmap, maxDimension = 2048)

            val fileId = UUID.randomUUID().toString()
            val fileName = "img_${fileId}.webp"
            val targetFile = File(mediaDir, fileName)

            val outputStream = FileOutputStream(targetFile)
            scaledBitmap.compress(Bitmap.CompressFormat.WEBP, 85, outputStream)
            outputStream.flush()
            outputStream.close()

            // 回收不再使用的位图，及时释放内存
            if (scaledBitmap !== originalBitmap) scaledBitmap.recycle()
            originalBitmap.recycle()

            Attachment(
                id = fileId,
                diaryId = diaryId,
                localPath = targetFile.absolutePath,
                fileName = fileName,
                fileSize = targetFile.length(),
                mimeType = "image/webp"
            )
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }

    private fun calculateInSampleSize(width: Int, height: Int, maxDimension: Int): Int {
        var sampleSize = 1
        var w = width
        var h = height
        while (w / 2 >= maxDimension || h / 2 >= maxDimension) {
            w /= 2
            h /= 2
            sampleSize *= 2
        }
        return sampleSize
    }

    private fun scaleBitmapIfNeeded(bitmap: Bitmap, maxDimension: Int): Bitmap {
        val width = bitmap.width
        val height = bitmap.height

        if (width <= maxDimension && height <= maxDimension) {
            return bitmap
        }

        val ratio = width.toFloat() / height.toFloat()
        val newWidth: Int
        val newHeight: Int

        if (width > height) {
            newWidth = maxDimension
            newHeight = (maxDimension / ratio).toInt()
        } else {
            newHeight = maxDimension
            newWidth = (maxDimension * ratio).toInt()
        }

        return Bitmap.createScaledBitmap(bitmap, newWidth, newHeight, true)
    }
}
