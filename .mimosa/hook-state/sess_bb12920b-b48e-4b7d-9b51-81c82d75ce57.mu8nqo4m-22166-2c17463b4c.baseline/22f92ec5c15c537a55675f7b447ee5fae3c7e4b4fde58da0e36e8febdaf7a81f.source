package com.example.inkpaperdiary.core.designsystem

import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.Shapes
import androidx.compose.ui.unit.dp

/**
 * 现代 iOS 连续平滑圆角体系 (iOS Squircle & Rounded Shapes)
 *
 * 遵循 iOS 规范：卡片为 16dp 连续平滑圆角，按钮/搜索栏为 10~12dp，标签/状态条为 50% 胶囊形。
 */
val CapsuleShape = RoundedCornerShape(50)

val PaperShapes = Shapes(
    extraSmall = RoundedCornerShape(6.dp),
    small = RoundedCornerShape(10.dp),      // 按钮、搜索框、输入框
    medium = RoundedCornerShape(16.dp),     // 现代内容卡片、成组列表卡片
    large = RoundedCornerShape(20.dp),      // 底部抽屉、浮动操作面板
    extraLarge = RoundedCornerShape(28.dp)  // 模态弹窗、警示对话框
)
