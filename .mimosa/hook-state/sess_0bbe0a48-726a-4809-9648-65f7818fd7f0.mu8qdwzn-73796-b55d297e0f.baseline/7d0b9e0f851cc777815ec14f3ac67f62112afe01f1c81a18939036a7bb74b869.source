package com.example.inkpaperdiary.core.database.entity

import androidx.room.Embedded
import androidx.room.Junction
import androidx.room.Relation
import com.example.inkpaperdiary.domain.model.*

data class DiaryWithDetails(
    @Embedded val diary: DiaryEntity,
    @Relation(
        parentColumn = "id",
        entityColumn = "diaryId"
    )
    val attachments: List<AttachmentEntity> = emptyList(),
    @Relation(
        parentColumn = "id",
        entityColumn = "id",
        associateBy = Junction(
            value = DiaryTagCrossRef::class,
            parentColumn = "diaryId",
            entityColumn = "tagId"
        )
    )
    val tags: List<TagEntity> = emptyList()
) {
    fun toDomain(): Diary {
        return Diary(
            id = diary.id,
            userId = diary.userId,
            title = diary.title,
            contentMarkdown = diary.contentMarkdown,
            weather = Weather.fromCode(diary.weather),
            locationName = diary.locationName,
            latitude = diary.latitude,
            longitude = diary.longitude,
            entryDate = diary.entryDate,
            createdAt = diary.createdAt,
            updatedAt = diary.updatedAt,
            isPinned = diary.isPinned,
            isDeleted = diary.isDeleted,
            deletedAt = diary.deletedAt,
            syncStatus = SyncStatus.fromCode(diary.syncStatus),
            tags = tags.map { Tag(id = it.id, name = it.name, colorHex = it.colorHex, createdAt = it.createdAt) },
            attachments = attachments.sortedBy { it.sortOrder }.map {
                Attachment(
                    id = it.id,
                    diaryId = it.diaryId,
                    localPath = it.localPath,
                    remoteUrl = it.remoteUrl,
                    fileName = it.fileName,
                    fileSize = it.fileSize,
                    mimeType = it.mimeType,
                    sortOrder = it.sortOrder,
                    syncStatus = SyncStatus.fromCode(it.syncStatus)
                )
            }
        )
    }
}
