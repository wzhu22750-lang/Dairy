package com.example.inkpaperdiary.ui.lock

import androidx.compose.foundation.background
import androidx.compose.foundation.border
import com.example.inkpaperdiary.core.designsystem.interaction.iosClick
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.grid.GridCells
import androidx.compose.foundation.lazy.grid.LazyVerticalGrid
import androidx.compose.foundation.lazy.grid.items
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.automirrored.filled.Backspace
import androidx.compose.material.icons.outlined.Fingerprint
import androidx.compose.material.icons.outlined.Lock
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.activity.compose.BackHandler
import androidx.fragment.app.FragmentActivity
import com.example.inkpaperdiary.core.designsystem.AppleMaterials
import com.example.inkpaperdiary.core.designsystem.MaterialThickness
import com.example.inkpaperdiary.core.designsystem.SansFontFamily
import com.example.inkpaperdiary.core.security.BiometricHelper

@Composable
fun LockScreen(
    viewModel: LockViewModel,
    onUnlocked: () -> Unit
) {
    val uiState by viewModel.uiState.collectAsState()
    val inputPin by viewModel.inputPin.collectAsState()
    val isUnlocked by viewModel.isUnlocked.collectAsState()
    val lockoutRemaining by viewModel.lockoutRemaining.collectAsState()
    val context = LocalContext.current
    val activity = context as? FragmentActivity

    // 处于锁屏状态下，禁止通过系统返回键返回到被保护的日记界面，直接退回系统桌面
    BackHandler(enabled = true) {
        activity?.moveTaskToBack(true)
    }

    LaunchedEffect(isUnlocked) {
        if (isUnlocked) {
            onUnlocked()
        }
    }

    // 自动尝试调起生物识别 (如果支持且开启)
    LaunchedEffect(uiState.biometricEnabled) {
        if (uiState.biometricEnabled && context is FragmentActivity && BiometricHelper.isBiometricAvailable(context)) {
            BiometricHelper.showBiometricPrompt(
                activity = context,
                onSuccess = { viewModel.unlockByBiometric() },
                onError = { /* 用户取消或使用 PIN 回退 */ }
            )
        }
    }

    Surface(
        modifier = Modifier.fillMaxSize(),
        color = MaterialTheme.colorScheme.background
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(32.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.SpaceBetween
        ) {
            Spacer(modifier = Modifier.height(20.dp))

            // 头部锁图标与提示
            Column(
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                Box(
                    modifier = Modifier
                        .size(60.dp)
                        .background(MaterialTheme.colorScheme.surfaceVariant, CircleShape)
                        .border(0.5.dp, MaterialTheme.colorScheme.outline, CircleShape),
                    contentAlignment = Alignment.Center
                ) {
                    Icon(
                        Icons.Outlined.Lock,
                        contentDescription = "安全锁",
                        tint = MaterialTheme.colorScheme.primary,
                        modifier = Modifier.size(28.dp)
                    )
                }

                Text(
                    text = "输入密码",
                    style = MaterialTheme.typography.titleLarge,
                    fontFamily = SansFontFamily,
                    fontWeight = FontWeight.Bold,
                    color = MaterialTheme.colorScheme.onBackground
                )

                Text(
                    text = "解锁以访问你的日记",
                    style = MaterialTheme.typography.bodySmall,
                    fontFamily = SansFontFamily,
                    color = MaterialTheme.colorScheme.secondary
                )

                // PIN 指示圆点：与 4 位密码严格一致
                Row(
                    horizontalArrangement = Arrangement.spacedBy(16.dp),
                    modifier = Modifier.padding(top = 16.dp)
                ) {
                    repeat(4) { index ->
                        val isFilled = index < inputPin.length
                        Box(
                            modifier = Modifier
                                .size(13.dp)
                                .clip(CircleShape)
                                .background(
                                    if (isFilled) MaterialTheme.colorScheme.onBackground else Color.Transparent
                                )
                                .border(
                                    1.dp,
                                    if (isFilled) MaterialTheme.colorScheme.onBackground else MaterialTheme.colorScheme.onBackground.copy(alpha = 0.35f),
                                    CircleShape
                                )
                        )
                    }
                }

                // 失败锁定冷却提示
                val lockoutSeconds = (lockoutRemaining + 999) / 1000
                if (lockoutSeconds > 0) {
                    Text(
                        text = "尝试次数过多，请 ${lockoutSeconds} 秒后再试",
                        style = MaterialTheme.typography.bodySmall,
                        fontFamily = SansFontFamily,
                        color = MaterialTheme.colorScheme.error
                    )
                }
            }

            // 数字九宫格键盘 (iOS 风格 76dp 圆形磨砂按键)
            val keys = listOf("1", "2", "3", "4", "5", "6", "7", "8", "9", "bio", "0", "del")

            LazyVerticalGrid(
                columns = GridCells.Fixed(3),
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(bottom = 28.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp),
                horizontalArrangement = Arrangement.spacedBy(24.dp)
            ) {
                items(keys) { key ->
                    when (key) {
                        "bio" -> {
                            if (uiState.biometricEnabled && context is FragmentActivity) {
                                Box(
                                    modifier = Modifier
                                        .size(76.dp)
                                        .clip(CircleShape)
                                        .iosClick {
                                            BiometricHelper.showBiometricPrompt(
                                                activity = context,
                                                onSuccess = { viewModel.unlockByBiometric() },
                                                onError = {}
                                            )
                                        },
                                    contentAlignment = Alignment.Center
                                ) {
                                    Icon(
                                        Icons.Outlined.Fingerprint,
                                        contentDescription = "指纹解锁",
                                        tint = MaterialTheme.colorScheme.primary,
                                        modifier = Modifier.size(34.dp)
                                    )
                                }
                            } else {
                                Spacer(modifier = Modifier.size(76.dp))
                            }
                        }
                        "del" -> {
                            Box(
                                modifier = Modifier
                                    .size(76.dp)
                                    .clip(CircleShape)
                                    .iosClick { viewModel.deletePinDigit() },
                                contentAlignment = Alignment.Center
                            ) {
                                Icon(
                                    Icons.AutoMirrored.Filled.Backspace,
                                    contentDescription = "删除",
                                    tint = MaterialTheme.colorScheme.secondary,
                                    modifier = Modifier.size(26.dp)
                                )
                            }
                        }
                        else -> {
                            Surface(
                                shape = CircleShape,
                                color = AppleMaterials.backgroundColor(MaterialThickness.THIN),
                                border = AppleMaterials.glassBorder(width = 0.5.dp),
                                modifier = Modifier
                                    .size(76.dp)
                                    .clip(CircleShape)
                                    .iosClick { viewModel.appendPinDigit(key) }
                            ) {
                                Box(contentAlignment = Alignment.Center) {
                                    Text(
                                        text = key,
                                        fontSize = 26.sp,
                                        fontFamily = androidx.compose.ui.text.font.FontFamily.Serif,
                                        fontWeight = FontWeight.Normal,
                                        color = MaterialTheme.colorScheme.onSurface
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
